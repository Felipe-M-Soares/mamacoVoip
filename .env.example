# Copie este arquivo para .env e preencha com as chaves do seu projeto Supabase
# Project Settings > API no dashboard do Supabase

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional — busca de GIFs no chat (developers.giphy.com > Create an API
# Key). Sem essa chave, o GIF picker fica desativado (ver src/lib/config.ts).
VITE_GIPHY_API_KEY=
