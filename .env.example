# Copie este arquivo para .env e preencha com as chaves do seu projeto Supabase
# Project Settings > API no dashboard do Supabase

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional — busca de GIFs no chat (developers.giphy.com > Create an API
# Key). Sem essa chave, o GIF picker fica desativado (ver src/lib/config.ts).
VITE_GIPHY_API_KEY=

# Voz e vídeo (LiveKit) — a URL do servidor LiveKit vem do próprio token
# emitido pela Edge Function (ver supabase/functions/livekit-token), não
# precisa configurar nada aqui no cliente. O que precisa ser configurado
# são as SECRETS da Edge Function, no dashboard do Supabase (Project
# Settings > Edge Functions > Secrets, ou `supabase secrets set`):
#   LIVEKIT_URL          — URL do seu servidor LiveKit (wss://...),
#                          tanto faz se é LiveKit Cloud (livekit.io) ou
#                          um servidor auto-hospedado
#   LIVEKIT_API_KEY      — API key do projeto/servidor LiveKit
#   LIVEKIT_API_SECRET   — API secret correspondente
