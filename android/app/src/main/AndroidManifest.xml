<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- AUDITORIA: allowBackup="false" — com "true", o backup automático
         do Android (nuvem do Google e `adb backup`) copiava os dados da
         WebView, incluindo a sessão de login do Supabase (token de
         acesso/renovação em localStorage). Restaurar esse backup em outro
         aparelho = já entrar logado na conta da pessoa. O app não guarda
         nada localmente que valha a pena restaurar (tudo vem do servidor). -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- VIGÉSIMA SEXTA RODADA — sem essas duas, getUserMedia (chamado
         pelo mesmo código React de sempre, sem mudança nenhuma nele)
         falha direto dentro da WebView do Capacitor: o Android bloqueia
         microfone/câmera por padrão, mesmo com a permissão de tempo de
         execução concedida, se ela não estiver declarada aqui no
         manifest também — as duas coisas (manifest + diálogo de
         permissão em tempo real) são exigidas juntas desde o Android 6.
         Isso resolve a metade "manifest" da exigência; a metade
         "diálogo em tempo de execução" ainda precisa ser testada de
         verdade no Android Studio (ver o aviso na resposta) — não tenho
         como confirmar esse comportamento sem um dispositivo/emulador
         Android de verdade, que não existe neste ambiente. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- BLUETOOTH (legado) só existe até o Android 11; do 12 em diante o
         que vale é BLUETOOTH_CONNECT logo abaixo. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Deixa o app aparecer só em aparelhos que realmente têm câmera E
         microfone — evita instalação em dispositivos incompatíveis via
         Play Store (mas não bloqueia o uso do app sem câmera, já que
         video chamada é opcional aqui). -->
    <uses-feature android:name="android.hardware.microphone" android:required="true" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
