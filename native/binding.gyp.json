{
  "targets": [
    {
      "target_name": "audio_capture",
      "sources": ["src/audio_capture.cc"],
      "include_dirs": [
        "<!(node -p \"require('node-addon-api').include_dir\")",
        "./include"
      ],
      "dependencies": [
        "<!(node -p \"require('node-addon-api').gyp\")"
      ],
      "conditions": [
        ["OS=='win'", {
          "libraries": [
            "-lole32",
            "-loleaut32",
            "-luuid",
            "-lwinmm",
            "-luser32"
          ],
          "defines": ["_WIN32_WINNT=0x0601"]
        }],
        ["OS=='mac'", {
          "libraries": [
            "-framework CoreAudio",
            "-framework AudioToolbox"
          ]
        }],
        ["OS=='linux'", {
          "libraries": [
            "-lpulse",
            "-lpulse-simple"
          ]
        }]
      ]
    }
  ]
}