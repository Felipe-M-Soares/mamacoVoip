{
  "name": "mamaco-voip",
  "version": "1.0.151",
  "description": "Clone funcional do Discord com React e Electron",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:start": "electron electron/main.cjs",
    "electron:build": "electron-builder",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron electron/main.cjs\"",
    "build:electron": "npm run build && npm run electron:build",
    "dist": "npm run build:electron"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.4",
    "@tailwindcss/vite": "^4.0.0-alpha.14",
    "axios": "^1.6.2",
    "electron-updater": "^6.1.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1",
    "tailwindcss": "^4.0.0-alpha.14"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^27.1.3",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.mamaco.voip",
    "productName": "Mamaco Voip",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "Felipe-M-Soares",
      "repo": "mamacoVoip"
    }
  }
}
