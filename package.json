{
  "name": "mamacos-voip",
  "private": true,
  "version": "1.0.0",
  "description": "Mamacos Voip — servidores, canais, chat em tempo real, voz e vídeo.",
  "author": "Mamacos Voip",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:electron": "tsc -b && vite build --mode electron",
    "build:mobile": "vite build && npx cap sync android",
    "cap:open:android": "npx cap open android",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "electron:start": "electron .",
    "electron:build": "npm run build:electron && electron-builder"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@sapphi-red/web-noise-suppressor": "^0.4.0",
    "@supabase/supabase-js": "^2.112.3",
    "electron-updater": "^6.8.9",
    "livekit-client": "^2.22.3",
    "lucide-react": "^1.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/ui": "^4.1.11",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.mamacosvoip.app",
    "productName": "Mamacos Voip",
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "directories": {
      "output": "release"
    },
    "asar": true,
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/uiohook-napi/**",
      "electron/process-audio-capture.exe",
      "electron/screen-capture-gdi.exe",
      "electron/screen-capture-wgc.exe"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "protocols": [
      {
        "name": "Mamacos Voip Auth",
        "schemes": [
          "mamacovoip"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "license": "build/license.txt",
      "language": "1046",
      "installerLanguages": [
        "pt_BR"
      ],
      "multiLanguageInstaller": false,
      "unicode": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Mamacos Voip",
      "uninstallDisplayName": "Mamacos Voip",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true,
      "differentialPackage": true,
      "artifactName": "MamacosVoip-Setup.exe"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "maintainer": "Mamacos Voip",
      "synopsis": "Chat em texto, voz e vídeo",
      "syncDesktopName": true
    },
    "publish": {
      "provider": "github",
      "owner": "Felipe-M-Soares",
      "repo": "mamacoVoip",
      "releaseType": "release"
    },
    "appx": {
      "applicationId": "MamacosVoip",
      "displayName": "Mamacos Voip",
      "publisherDisplayName": "zom1n1",
      "backgroundColor": "#07070a",
      "languages": [
        "pt-BR",
        "en-US"
      ],
      "showNameOnTiles": true,
      "artifactName": "MamacosVoip-Store.${ext}",
      "identityName": "zom1n1.MamacosVoip",
      "publisher": "CN=7C32AF9F-38B6-40EA-B20F-D1219940C232"
    }
  }
}
