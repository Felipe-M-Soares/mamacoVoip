{
  "name": "mamaco-voip",
  "version": "1.0.0",
  "description": "Clone funcional do Discord com React e Electron",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:start": "electron electron/main.cjs",
    "electron:build": "electron-builder",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron electron/main.cjs\"",
    "build:electron": "npm run build && npm run electron:build",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-rebuild -f -w wrtc",
    "fix-wrtc": "node scripts/fix-wrtc.js",
    "dist": "npm run build:electron"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.0",
    "axios": "^1.6.2",
    "electron-updater": "^6.1.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "tailwindcss": "^3.3.6",
    "wrtc": "^0.4.7"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/wrtc": "^0.4.0",
    "@vitejs/plugin-react": "^4.1.1",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4",
    "electron-rebuild": "^3.2.9",
    "typescript": "^5.3.2",
    "vite": "^4.5.0",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.mamaco.voip",
    "productName": "Mamaco Voip",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "node_modules/**/*",
      "!node_modules/wrtc/build/Release/obj/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "Felipe-M-Soares",
      "repo": "mamacoVoip"
    }
  }
}
